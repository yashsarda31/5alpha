{
  "crons": [
    {
      "path": "/api/delivery/refresh",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/predict/resolve",
      "schedule": "30 10 * * 1-5"
    }
  ],
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "{web/**,research/**,docs/**,install-tests/**,*.pptx,*.jpeg,*.json,test_*.py,verify_*.py,alpha-nova-*.html,alphanova48-growth-dashboard.html,run_server.py,requirements.txt}"
      }
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable",
        "x-content-type-options": "nosniff"
      },
      "dest": "/web/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "headers": { "cache-control": "public, max-age=86400" },
      "dest": "/web/favicon.svg"
    },
    {
      "src": "/robots.txt",
      "headers": { "cache-control": "public, max-age=86400" },
      "dest": "/web/robots.txt"
    },
    {
      "src": "/manifest.webmanifest",
      "headers": {
        "content-type": "application/manifest+json",
        "cache-control": "public, max-age=3600"
      },
      "dest": "/web/manifest.webmanifest"
    },
    {
      "src": "/sw.js",
      "headers": { "cache-control": "no-cache" },
      "dest": "/web/sw.js"
    },
    {
      "src": "/apple-touch-icon-v2\\.png",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/web/apple-touch-icon-v2.png"
    },
    {
      "src": "/apple-touch-icon-v3\\.png",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/web/apple-touch-icon-v3.png"
    },
    {
      "src": "/apple-touch-icon-v4\\.png",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/web/apple-touch-icon-v4.png"
    },
    {
      "src": "/brand/(.*)",
      "headers": { "cache-control": "public, max-age=86400" },
      "dest": "/web/brand/$1"
    },
    {
      "src": "/icons/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/web/icons/$1"
    },
    {
      "src": "/fonts/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/web/fonts/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "headers": {
        "x-content-type-options": "nosniff",
        "x-frame-options": "DENY",
        "referrer-policy": "strict-origin-when-cross-origin",
        "permissions-policy": "camera=(), microphone=(), geolocation=()",
        "strict-transport-security": "max-age=63072000; includeSubDomains"
      },
      "dest": "/web/index.html"
    }
  ]
}

{
  "crons": [
    {
      "path": "/api/delivery/refresh",
      "schedule": "0 14 * * 1-5"
    }
  ],
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/main.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/web/assets/$1"
    },
    {
      "src": "/favicon.svg",
      "dest": "/web/favicon.svg"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/web/index.html"
    }
  ]
}
